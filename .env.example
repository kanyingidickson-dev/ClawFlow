# ClawFlow Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# OpenClaw Integration
# =============================================================================

# Optional: API key for authenticating OpenClaw agent requests
# When set, all requests to /api/webhook/openclaw must include:
# Header: x-api-key: <OPENCLAW_API_KEY>
# 
# If not set, the webhook endpoint accepts requests without authentication
# (useful for local development)
OPENCLAW_API_KEY=your_secure_api_key_here

# Example OpenClaw agent configuration:
# See openclaw.config.yml for a complete agent setup example

# =============================================================================
# Database
# =============================================================================

# SQLite database file path (default: ./sqlite.db)
# DATABASE_URL=file:./sqlite.db

# =============================================================================
# Development
# =============================================================================

# Next.js dev server port (default: 3000)
# PORT=3000
